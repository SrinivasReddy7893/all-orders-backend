# Copy to .env and fill in. The server checks these at startup (src/config/env.ts).

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/all_orders

# Signs login tokens — at least 32 random characters: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Encrypts stored Gmail tokens — 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Frontend origins allowed to call the API, comma-separated (required in production)
CORS_ORIGINS=http://localhost:3000
